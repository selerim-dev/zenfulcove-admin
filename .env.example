ADMIN_PASSWORD=
CRON_SECRET=
CRON_DRY_RUN=false

# Supabase project "Zenfulcove kayaks":
# Project URL -> NEXT_PUBLIC_SUPABASE_URL
# Publishable key -> NEXT_PUBLIC_SUPABASE_ANON_KEY
# Secret key or legacy service_role key -> SUPABASE_SERVICE_ROLE_KEY
# Direct connection string -> DATABASE_URL (local migration helper only)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=

KV_REST_API_URL=
KV_REST_API_TOKEN=
# Optional Upstash fallback names used by lib/kv.js:
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

LODGIFY_API_KEY=
JOTFORM_API_KEY=
JOTFORM_EU=false
JOTFORM_BOOKING_CONFIRMATION_FIELD_ID=

SENDGRID_API_KEY=

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
TWILIO_EVENTS_FROM_NUMBER=
TWILIO_SKIP_SIGNATURE_CHECK=false

SALESMATE_DOMAIN=
SALESMATE_LINK_NAME=
SALESMATE_SESSION_KEY=
SALESMATE_OWNER_ID=

# Stripe Checkout for paid/additional rentals.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Optional for future embedded Stripe UI; hosted Checkout does not require it.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Public app URL used for Stripe success/cancel redirects in production.
NEXT_PUBLIC_SITE_URL=
